{
  "_comment": "Cumulative crate/module placement oracle for the Rust tree. Field meaning and the placement algorithm: docs/schemas/crates.md. The orchestrator authors it lazily; `crustify-cli crates locate|validate` only reads it.",

  "crates": {
    "libssl": {
      "kind": "library",
      "in_tree": true,
      "crate_path": "crustify/rust/libssl",
      "sys_crate": "crustify/rust/libssl-sys",
      "depends_on": ["libcrypto", "libc"],
      "modules": {
        "statem": {
          "rust_path": "src/statem",
          "rs": {
            "src/statem/statem_lib.rs": {
              "_comment": "TU + its own headers: functions from statem_lib.c and a type defined in one of the headers below co-home here.",
              "tu": "ssl/statem/statem_lib.c",
              "headers": ["ssl/statem/statem_local.h", "include/internal/statem.h"],
              "members": {
                "functions": ["tls_setup_handshake", "ossl_statem_set_in_init"],
                "types": ["ossl_statem_st"],
                "callbacks": [],
                "macros": [],
                "globals": []
              }
            }
          }
        },
        "quic": {
          "rust_path": "src/quic",
          "rs": {
            "src/quic/quic_ackm.rs": {
              "_comment": "STEM-PARTNER attribution: include/internal/quic_ackm.h names no crate on its own (include/ is in several libraries' include_dirs and no library's source_dirs), but it shares a stem with ssl/quic/quic_ackm.c — so it takes that TU's crate and module, and both co-home in this one .rs.",
              "tu": "ssl/quic/quic_ackm.c",
              "headers": ["include/internal/quic_ackm.h"],
              "members": {
                "functions": ["ossl_ackm_new", "ossl_ackm_free"],
                "types": ["ossl_ackm_st"],
                "callbacks": [],
                "macros": [],
                "globals": []
              }
            }
          }
        }
      }
    },

    "libcrypto": {
      "kind": "library",
      "in_tree": true,
      "crate_path": "crustify/rust/libcrypto",
      "sys_crate": "crustify/rust/libcrypto-sys",
      "depends_on": ["libc"],
      "modules": {
        "comp": {
          "rust_path": "src/comp",
          "rs": {
            "src/comp/comp.rs": {
              "_comment": "No TU — a header-only module. stack_st_SSL_COMP is declared but never defined, so it homes by its best-fit header. OPENSSL_malloc is homed for library attribution only: translator agents add its `-sys` binding lazily, and no anchor is laid.",
              "tu": null,
              "headers": ["include/openssl/comp.h", "include/internal/cryptlib.h"],
              "members": {
                "functions": [],
                "types": ["stack_st_SSL_COMP"],
                "callbacks": ["COMP_METHOD_free_fn"],
                "macros": ["OPENSSL_malloc"],
                "globals": []
              }
            }
          }
        }
      }
    },

    "fips": {
      "kind": "library",
      "in_tree": true,
      "crate_path": "crustify/rust/fips",
      "sys_crate": "crustify/rust/fips-sys",
      "depends_on": ["libc"],
      "modules": {}
    },

    "legacy": {
      "kind": "library",
      "in_tree": true,
      "crate_path": "crustify/rust/legacy",
      "sys_crate": "crustify/rust/legacy-sys",
      "depends_on": ["libcrypto", "libc"],
      "modules": {}
    },

    "openssl": {
      "kind": "executable",
      "in_tree": true,
      "crate_path": "crustify/rust/openssl",
      "depends_on": ["libssl", "libcrypto", "libc"],
      "modules": {}
    },

    "libc": {
      "kind": "library",
      "in_tree": false,
      "crate_path": "crustify/rust/libc",
      "sys_crate": "crustify/rust/libc-sys",
      "depends_on": [],
      "_comment": "Out-of-tree dependency. `in_tree: false` is provenance only — it gets a -sys crate and a wrapper crate like any in-tree library, and its wrappers obey the same SAFETY discipline. Its entities simply have no TU.",
      "modules": {
        "mem": {
          "rust_path": "src/mem",
          "rs": {
            "src/mem.rs": {
              "tu": null,
              "headers": ["string.h"],
              "members": {
                "functions": ["memcpy", "memset"],
                "types": [],
                "callbacks": [],
                "macros": ["NULL"],
                "globals": []
              }
            }
          }
        }
      }
    }
  }
}
