# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/

# IDE
.idea/
.vscode/
*.code-workspace
*.swp
*.swo

# OS
.DS_Store

# Temp
tmp/

# git worktrees
.worktrees/

# The rustc driver crate is built at run time against the nightly driving
# that run, so its build tree never belongs in the repository.
src/driver/target/

# Rust build trees anywhere -- test fixtures build too, and the driver's is
# rebuilt against whichever nightly drives a run.
target/

# Audit and campaign artifacts written INTO a repository under audit. This
# repository is not itself a target, but a stray run must not be committed.
crustify/
